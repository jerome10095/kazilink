# Frontend (Vite) — safe to expose in the browser bundle.
# Supabase dashboard -> Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Netlify Functions (server-side only — never expose SUPABASE_SERVICE_ROLE_KEY to the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public contact details (all optional). Anything left blank is simply not shown on the site.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_LOCATION=
VITE_CONTACT_HOURS=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
